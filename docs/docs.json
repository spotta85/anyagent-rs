{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "anyagent",
  "description": "One Rust interface to the coding agents installed on a machine.",
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#e8763a",
    "light": "#e8763a",
    "dark": "#c25a25"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "styling": {
    "codeblocks": {
      "theme": "vesper"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt",
      "cursor",
      "vscode"
    ]
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "quickstart",
          "features",
          "supported-agents"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "concepts"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/discovery",
          "guides/sessions",
          "guides/events",
          "guides/conversations"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "crates.io",
        "href": "https://crates.io/crates/anyagent"
      },
      {
        "label": "API reference",
        "href": "https://docs.rs/anyagent"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/spotta85/anyagent-rs"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/spotta85/anyagent-rs"
    }
  }
}
